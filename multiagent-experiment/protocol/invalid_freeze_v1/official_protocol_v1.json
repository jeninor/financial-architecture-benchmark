{
  "schema_version": 1,
  "protocol_name": "official_finance_architecture_experiment_v1",
  "run_kind": "official",
  "provider": "claude-code",
  "model_requested": "claude-sonnet-5-5",
  "expected_canonical_model": "claude-sonnet-5-5",
  "graphify": {
    "image": "graphify-mcp:0.9.73",
    "budget": 1200,
    "mode": "orchestrator-side-retrieval-after-failure"
  },
  "quality": {
    "image": "multiagent-lizard:1.24.0",
