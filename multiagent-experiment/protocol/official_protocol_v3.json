{
  "schema_version": 3,
  "protocol_name": "official_finance_architecture_experiment_v3",
  "run_kind": "official",
  "provider": "claude-code",
  "model_requested": "claude-sonnet-5-5",
  "expected_canonical_model": "claude-sonnet-5-5",
  "graphify": {
    "image": "graphify-mcp:0.9.73",
    "budget": 1200,
    "mode": "orchestrator-side-retrieval-after-failure"
  },
  "quality": {
    "image": "multiagent-lizard:1.24.0",
    "policy": "multiagent-experiment/policies/quality_policy.json"
  },
  "security": {
    "image": "aquasec/trivy:0.74.0",
    "policy": "multiagent-experiment/policies/security_policy_v2.json",
    "cache": "multiagent-experiment/tool-cache/trivy",
    "cache_manifest": "multiagent-experiment/protocol/TRIVY_CACHE_MANIFEST_V3.json",
    "offline_only": true,
    "required_cache_files": [
      "db/trivy.db",
      "db/metadata.json",
      "java-db/trivy-java.db",
      "java-db/metadata.json",
      "policy/metadata.json"
    ],
    "preflight": "required-files+full-cache-hash+offline-vuln+offline-secret-misconfig"
  },
  "limits": {
    "startup_timeout_seconds": 360,
    "a1_max_iterations": 3,
    "a1_first_max_turns": 15,
    "a1_fix_max_turns": 8,
    "a3_refactor_max_turns": 8,
    "a3_repair_max_turns": 5,
    "a3_max_repair_attempts": 1,
    "infra_preflight_max_attempts": 3,
    "infra_preflight_timeout_seconds": 120,
    "infra_stability_seconds": 8,
    "infra_runtime_recovery_attempts": 2,
    "docker_settle_seconds": 3,
    "application_readiness_stable_checks": 3,
    "application_readiness_poll_seconds": 2
  },
  "acceptance": {
    "required_passed": 12,
    "required_total": 12
  },
  "cache_policy": {
    "database_state": "clean-before-each-agent-execution-attempt",
    "maven_cache": "preserve-existing-named-maven-cache-within-run-project",
    "notes": "The orchestrator starts each Claude execution attempt from fresh database/broker volumes, preserves the run-scoped Maven cache, and verifies infrastructure before Claude is called."
  },
  "expected_claude_code_version_prefix": "2.1.286",
  "environment_lock": "multiagent-experiment/protocol/environment_lock_v3.json",
  "protocol_file": "multiagent-experiment/protocol/official_protocol_v3.json",
  "infrastructure_policy": {
    "preflight_before_claude": true,
    "infra_retries_consume_claude_iterations": false,
    "independent_infra_services": {
      "monolith": [
        "postgres",
        "postgres-test"
      ],
      "microservices": [
        "rabbitmq",
        "user-postgres",
        "trade-postgres"
      ]
    },
    "capture_all_service_logs_and_health": true,
    "application_readiness": "all key public routes reachable without gateway 502/503 for 3 consecutive polls",
    "graphify_after_final_a1_attempt": false,
    "classification": "independent dependency failure => INFRASTRUCTURE_ABORT; app/acceptance failure after healthy infrastructure => experimental agent outcome"
  }
}
