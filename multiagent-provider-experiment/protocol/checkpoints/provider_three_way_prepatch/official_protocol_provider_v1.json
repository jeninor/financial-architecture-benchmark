{
  "schema_version": 1,
  "protocol_name": "official_finance_architecture_provider_experiment_v1",
  "run_kind": "official",

  "providers": {
    "codex": {
      "expected_cli_version": "codex-cli 0.160.0",
      "model_requested": null,
      "model_verification": "explicit_cli_argument_only",
      "policy": {
        "workspace_write": "sandbox_enforced",
        "outside_workspace_write": "blocked_and_smoke_verified",
        "shell_network": "blocked_and_smoke_verified",
        "docker": "forbidden_and_trace_audited",
        "web_browser": "forbidden",
        "mcp": "forbidden",
        "subagents": "forbidden"
      }
    },

    "antigravity": {
      "expected_cli_version": "1.2.16",
      "model_requested": "gemini-3.1-pro-high",
      "model_verification": "trace_init_model",
      "policy": {
        "workspace_write": "sandbox_enforced",
        "outside_workspace_write": "blocked_and_smoke_verified",
        "shell_network": "blocked_and_smoke_verified",
        "docker": "forbidden_and_trace_audited",
        "web_browser": "forbidden_and_trace_audited",
        "mcp": "forbidden_and_trace_audited",
        "subagents": "forbidden_and_trace_audited"
      }
    }
  },

  "graphify": {
    "image": "graphify-mcp:0.9.73",
    "budget": 1200,
    "mode": "orchestrator-side-retrieval-after-failure"
  },

  "quality": {
    "image": "multiagent-lizard:1.24.0",
    "policy": "multiagent-provider-experiment/policies/quality_policy.json"
  },

  "security": {
    "image": "aquasec/trivy:0.74.0",
    "policy": "multiagent-provider-experiment/policies/security_policy_v2.json",
    "cache": "multiagent-experiment/tool-cache/trivy",
    "cache_manifest": "multiagent-experiment/protocol/TRIVY_CACHE_MANIFEST_V3.json",
    "offline_only": true,
    "allow_initialization": false,
    "required_cache_files": [
      "db/trivy.db",
      "db/metadata.json",
      "java-db/trivy-java.db",
      "java-db/metadata.json",
      "policy/metadata.json"
    ],
    "preflight": "required-files+full-cache-hash+offline-vuln+offline-secret-misconfig"
  },

  "limits": {
    "startup_timeout_seconds": 360,

    "a1_max_iterations": 3,
    "a1_initial_timeout_seconds": 2400,
    "a1_repair_timeout_seconds": 1200,

    "a3_refactor_timeout_seconds": 1200,
    "a3_repair_timeout_seconds": 900,
    "a3_max_repair_attempts": 1,

    "infra_preflight_max_attempts": 3,
    "infra_preflight_timeout_seconds": 120,
    "infra_stability_seconds": 8,
    "infra_runtime_recovery_attempts": 2,
    "docker_settle_seconds": 3,

    "application_readiness_stable_checks": 3,
    "application_readiness_poll_seconds": 2
  },

  "acceptance": {
    "required_passed": 12,
    "required_total": 12
  },

  "cache_policy": {
    "database_state": "clean-before-each-provider-execution-attempt",
    "maven_cache": "preserve-existing-named-maven-cache-within-run-project",
    "notes": "The orchestrator starts each provider execution attempt from fresh database/broker volumes, preserves the run-scoped Maven cache, and verifies infrastructure before the coding provider is called."
  },

  "environment_lock": "multiagent-provider-experiment/protocol/environment_lock_provider_v1.json",
  "protocol_file": "multiagent-provider-experiment/protocol/official_protocol_provider_v1.json",

  "infrastructure_policy": {
    "preflight_before_provider": true,
    "infra_retries_consume_provider_iterations": false,

    "independent_infra_services": {
      "monolith": [
        "postgres",
        "postgres-test"
      ],
      "microservices": [
        "rabbitmq",
        "user-postgres",
        "trade-postgres"
      ]
    },

    "capture_all_service_logs_and_health": true,
    "application_readiness": "all key public routes reachable without gateway 502/503 for 3 consecutive polls",
    "graphify_after_final_a1_attempt": false,

    "classification": "independent dependency failure => INFRASTRUCTURE_ABORT; provider policy/runtime/model failure => invalid or aborted provider execution; app/acceptance failure after healthy infrastructure => experimental agent outcome"
  },

  "cost_policy": {
    "monetary_cost_comparable": false,
    "reported_cost_usd": null,
    "native_usage_preserved_per_invocation": true
  }
}
